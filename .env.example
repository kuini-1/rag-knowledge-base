# Claude API key for generated answers. Leave empty and set
# RAG_ANSWER_MODE=extractive to run without one.
ANTHROPIC_API_KEY=
RAG_ANSWER_MODE=

# Signs session tokens. At least 32 random bytes, e.g. `openssl rand -hex 32`.
RAG_JWT_SECRET=

# Let anyone register (the first account is always allowed and becomes admin).
RAG_ALLOW_SIGNUP=true

# Monthly token budget for new users.
RAG_DEFAULT_BUDGET=200000

# Optional overrides. RAG_MODEL can also be ollama:<name> for a local model,
# e.g. ollama:qwen3:4b-instruct.
RAG_MODEL=claude-opus-5-5
RAG_EFFORT=medium
RAG_CHUNKING=structure-256-32-ctx

# Ollama server for ollama:<name> models (default http://127.0.0.1:11434;
# from inside Docker use http://host.docker.internal:11434).
OLLAMA_HOST=
